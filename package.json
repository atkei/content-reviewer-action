{
  "name": "content-reviewer-action",
  "version": "0.0.1",
  "description": "GitHub Action for LLM-powered content review",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx ncc build src/main.ts -o dist && rm -f dist/*.d.ts.map",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src __tests__ --ext .ts",
    "lint:fix": "eslint src __tests__ --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atkei/content-reviewer-action.git"
  },
  "keywords": [
    "github-action",
    "content-review",
    "ai",
    "llm"
  ],
  "author": "atkei",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/atkei/content-reviewer-action/issues"
  },
  "homepage": "https://github.com/atkei/content-reviewer-action#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@content-reviewer/core": "^0.0.6",
    "glob": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^8.57.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
